@import "./rose-pine.css";

* {
  background-color: @base;
  color: @foreground;

  border: none;
  border-radius: 0;
  min-height: 0;
  font-family: 'Cascadia Code NF';
  font-size: 12px;
}

.modules-left {
  margin-left: 8px;
}

.modules-right {
  margin-right: 8px;
}

#workspaces button {
  all: initial;
  padding: 0 6px;
  margin: 0 1.5px;
  min-width: 9px;
}

#workspaces button.empty {
  opacity: 0.5;
}
#prova,
#cpu,
#backlight,
#pulseaudio,
#wireplumber,
#network,
#bluetooth,
#custom-expand-icon,
#custom-language,
#language{
  margin-right: 15px;
}
#battery{
  margin-right: 8px;
}

/* --- CONFIGURAZIONE BATTERIA MODIFICATA --- */
#battery {
  margin-right: 8px;
  transition: color 0.5s; /* Cambio colore fluido */
}

/* Quando è in carica (Verde/Foam) */
#battery.charging, #battery.plugged {
  color: #9ccfd8; 
}

/* Livello Warning (Sotto il 20% - Arancione/Gold) */
#battery.warning {
  color: #f6c177; 
}

/* Livello Critico (Sotto il 10% - Rosso/Love + Lampeggiante) */
#battery.critical {
  color: #eb6f92; 
  animation-name: blink;
  animation-duration: 0.5s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

/* Animazione del lampeggiamento */
@keyframes blink {
  to {
    color: @foreground; /* Lampeggia tra Rosso e il colore del testo normale */
  }
}
/* ------------------------------------------ */

#language{
  margin-top: 1px;
}
#custom-expand-icon{
  margin-top: 2px;
}

#tray{
  margin-right: 10px;
}
#clock {
  margin-left: 10px;
}

.hidden {
  opacity: 0;
}

